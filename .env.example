# Copy to .env and fill in. Read by docker compose and by run.sh, and never committed.
# Leave the values blank to run without the AI coach: every other feature works, and the coach
# screen still shows its figures, which are computed by the API rather than by the model.
# Either the resource root or the full target URI Azure offers for copying; both work.
COACH_ENDPOINT=https://your-resource.openai.azure.com/
COACH_API_KEY=
COACH_DEPLOYMENT=gpt-4o-mini
